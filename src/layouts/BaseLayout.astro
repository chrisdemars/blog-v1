---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ContactSection from '../components/ContactSection.astro';
import { SITE } from '../config';

interface Props {
  title: string;
  description: string;
  // Keeps the page out of search results (pair with the sitemap filter).
  noindex?: boolean;
  // The contact form closes every page except where it would be redundant.
  contact?: boolean;
}

const { title, description, noindex = false, contact = true } = Astro.props;
const pageTitle = title === SITE.title ? title : `${title} | ${SITE.title}`;
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.name}: Blog`}
      href={new URL('rss.xml', Astro.site)}
    />
    <slot name="head" />
    <ClientRouter />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[60] focus:rounded-md focus:bg-action focus:px-4 focus:py-2 focus:text-on-action"
    >
      Skip to content
    </a>
    <Nav />
    <main id="content" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
      {/* Inside <main> so it joins the section color alternation. */}
      {contact && <ContactSection />}
    </main>
    <Footer />
  </body>
</html>
