---
import BaseLayout from './BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  contact?: boolean;
}

const { title, description, noindex, contact } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  noindex={noindex}
  contact={contact}
>
  <PageHeader title={title} />
  <slot />
</BaseLayout>
