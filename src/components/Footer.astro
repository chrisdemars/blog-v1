---
import { NAV_LINKS, SITE, SOCIALS } from '../config';

const socials = [
  { href: SOCIALS.github, label: 'GitHub' },
  { href: SOCIALS.linkedin, label: 'LinkedIn' },
  { href: SOCIALS.sessionize, label: 'Sessionize' },
  { href: SOCIALS.twitter, label: 'Twitter' },
  { href: '/rss.xml', label: 'RSS' },
];
---

<footer class="surface-primary border-t border-surface-border">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 text-sm sm:grid-cols-2 sm:px-6">
    <nav aria-label="Footer">
      <ul class="flex flex-wrap gap-x-5 gap-y-2">
        {NAV_LINKS.map(({ href, label }) => (
          <li>
            <a href={href}>{label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <ul class="flex flex-wrap gap-x-5 gap-y-2 sm:justify-end">
      {socials.map(({ href, label }) => (
        <li>
          <a href={href} rel={href.startsWith('http') ? 'me' : undefined}>
            {label}
          </a>
        </li>
      ))}
    </ul>
    <p class="text-on-surface-muted sm:col-span-2">
      © {new Date().getFullYear()} {SITE.name}
    </p>
  </div>
</footer>
