---
import { NAV_LINKS, SITE } from '../config';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) =>
  path === href || path.startsWith(`${href}/`);
---

<header class="sticky top-0 z-50 border-b border-surface-border bg-surface/95 backdrop-blur">
  <nav
    aria-label="Primary"
    class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 px-4 py-3 sm:px-6"
  >
    <a href="/" class="font-mono font-semibold text-on-surface no-underline">
      {SITE.name}
    </a>

    <button
      type="button"
      class="nav-toggle rounded-md border border-surface-border px-3 py-1.5 text-sm md:hidden"
      aria-expanded="false"
      aria-controls="nav-menu"
      hidden
    >
      Menu
    </button>

    <ul
      id="nav-menu"
      class="flex w-full flex-col gap-1 py-3 md:flex md:w-auto md:flex-row md:items-center md:gap-6 md:py-0"
    >
      {NAV_LINKS.map(({ href, label }) => (
        <li>
          <a
            href={href}
            aria-current={isCurrent(href) ? 'page' : undefined}
            class="block py-2 text-on-surface-muted no-underline hover:text-link aria-[current=page]:text-link aria-[current=page]:underline md:py-0"
          >
            {label}
          </a>
        </li>
      ))}
      <li class="mt-2 md:mt-0">
        <a
          href="#contact"
          class="inline-block rounded-md bg-action px-4 py-2 font-semibold text-on-action no-underline hover:opacity-90"
        >
          Book me
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  // Without JS the menu is always open. With JS, it collapses below md
  // behind a disclosure button.
  function setUpNav() {
    const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
    const menu = document.getElementById('nav-menu');
    if (!toggle || !menu) return;

    const mobile = window.matchMedia('(max-width: 47.99rem)');
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.classList.toggle('hidden', mobile.matches && !open);
    };

    toggle.hidden = false;
    setOpen(false);
    toggle.addEventListener('click', () =>
      setOpen(toggle.getAttribute('aria-expanded') !== 'true'),
    );
    mobile.addEventListener('change', () => setOpen(false));
    menu.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && mobile.matches) {
        setOpen(false);
        toggle.focus();
      }
    });
  }

  document.addEventListener('astro:page-load', setUpNav);
</script>
