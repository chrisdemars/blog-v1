---
import { Image } from 'astro:assets';
import headshot from '../assets/headshot.jpg';
import { SITE } from '../config';
---

<section class="section surface-primary overflow-hidden" data-variant="primary">
  <div class="relative mx-auto max-w-[961px]">
    <Image
      src={headshot}
      alt="Chris DeMars talking with other developers at Chain React"
      widths={[480, 768, 961]}
      sizes="(min-width: 961px) 961px, 100vw"
      loading="eager"
      fetchpriority="high"
      class="block h-auto w-full"
    />
    <!-- Fade the people on either side, and the bottom edge into the text. -->
    <div
      class="hero-fade pointer-events-none absolute inset-0"
      aria-hidden="true"
    ></div>
  </div>

  <div class="relative mx-auto -mt-16 max-w-5xl px-4 pb-16 text-center sm:-mt-24 sm:px-6 sm:pb-24">
    <h1 class="text-4xl font-bold tracking-tight sm:text-6xl">{SITE.name}</h1>
    <p class="mt-3 font-mono text-lg text-link sm:text-xl">{SITE.jobTitle}</p>
    <p class="mx-auto mt-6 max-w-2xl text-lg text-on-surface-muted">
      Conference speaker on software supply chain security, accessibility, and
      frontend engineering. Based in Metro Detroit.
    </p>
  </div>
</section>

<style>
  .hero-fade {
    background:
      linear-gradient(
        to right,
        var(--color-primary) 0%,
        color-mix(in srgb, var(--color-primary) 85%, transparent) 24%,
        transparent 38%,
        transparent 64%,
        color-mix(in srgb, var(--color-primary) 85%, transparent) 78%,
        var(--color-primary) 100%
      ),
      linear-gradient(to bottom, transparent 50%, var(--color-primary) 100%);
  }
</style>
