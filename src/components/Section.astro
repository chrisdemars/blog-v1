---
import type { HTMLAttributes } from 'astro/types';
import { SURFACE_CLASS, type SurfaceVariant } from '../lib/surfaces';

interface Props extends HTMLAttributes<'section'> {
  // Leave unset to alternate automatically with the sections around it.
  variant?: SurfaceVariant;
}

const { variant, class: className, ...attrs } = Astro.props;
---

<section
  class:list={[
    'section py-16 sm:py-24',
    variant && SURFACE_CLASS[variant],
    className,
  ]}
  data-variant={variant}
  {...attrs}
>
  <div class="mx-auto max-w-5xl px-4 sm:px-6">
    <slot />
  </div>
</section>
