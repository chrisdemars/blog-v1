---
// Hidden reference for the site's design decisions (#15). Not linked from
// anywhere, noindex, and filtered out of the sitemap in astro.config.mjs.
import PageLayout from '../layouts/PageLayout.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import Tag from '../components/Tag.astro';
import Card from '../components/Card.astro';
import HomeHero from '../components/HomeHero.astro';
import globalCss from '../styles/global.css?raw';
import { CONTRAST_PAIRS, contrastRatio, parseTokens } from '../lib/contrast';
import { SURFACE_CLASS } from '../lib/surfaces';
import { Code } from 'astro:components';
import { codeTheme } from '../styles/code-theme';

const tokens = parseTokens(globalCss);
const hex = Object.fromEntries(tokens.map(({ name, hex }) => [name, hex]));

const contrast = CONTRAST_PAIRS.map((pair) => {
  const ratio = contrastRatio(hex[pair.fg], hex[pair.bg]);
  return { ...pair, ratio, passes: ratio >= pair.min };
});

const typeScale = [
  {
    label: 'Home hero name',
    class: 'text-4xl font-bold tracking-tight sm:text-6xl',
  },
  {
    label: 'Page title (h1)',
    class: 'text-3xl font-bold tracking-tight sm:text-5xl',
  },
  { label: 'Section heading (h2)', class: 'text-3xl font-bold' },
  { label: 'Card heading (h3)', class: 'text-lg font-semibold' },
  { label: 'Body', class: 'text-base' },
  { label: 'Lead / intro', class: 'text-lg text-on-surface-muted' },
  {
    label: 'Eyebrow / meta (mono)',
    class: 'font-mono text-sm text-on-surface-muted',
  },
];

const codeSample = `// Block install-time scripts from dependencies
import { readFile } from 'node:fs/promises';

const pkg = JSON.parse(await readFile('package.json', 'utf8'));
const MAX_DEPS = 42;

export function audit(deps: string[]): boolean {
  return deps.length <= MAX_DEPS && !pkg.scripts?.postinstall;
}`;

const variants = Object.keys(SURFACE_CLASS) as (keyof typeof SURFACE_CLASS)[];
---

<PageLayout
  title="Design System"
  description="Colors, type, and components used across the site."
  noindex
>
  <Section aria-labelledby="colors">
    <h2 id="colors" class="text-3xl font-bold">
      Colors
    </h2>
    <p class="mt-2 max-w-prose">
      Matched to spacetimedb.com. Read live from{' '}
      <code>src/styles/global.css</code>, so this list can't drift from the
      site.
    </p>
    <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {tokens.map(({ name, hex, source }) => (
        <li class="surface-primary overflow-hidden rounded-xl border border-surface-border">
          <div class="h-16" style={{ background: hex }} />
          <div class="p-4 text-sm">
            <p class="font-mono font-semibold">--color-{name}</p>
            <p class="mt-1 font-mono">{hex}</p>
            {source && <p class="mt-1 text-on-surface-muted">{source}</p>}
          </div>
        </li>
      ))}
    </ul>
  </Section>

  <Section aria-labelledby="contrast">
    <h2 id="contrast" class="text-3xl font-bold">
      Contrast
    </h2>
    <p class="mt-2 max-w-prose">
      WCAG AA: 4.5:1 for text, 3:1 for focus rings. Required pairs are also
      checked in CI by <code>npm run check:contrast</code>. Accents are for dark
      sections only; the "avoid" rows show why.
    </p>
    <div class="mt-8 overflow-x-auto">
      <table class="w-full min-w-xl text-left text-sm">
        <thead class="border-b-2 border-surface-border">
          <tr>
            <th scope="col" class="py-2 pr-4">
              Sample
            </th>
            <th scope="col" class="py-2 pr-4">
              Text on background
            </th>
            <th scope="col" class="py-2 pr-4">
              Use
            </th>
            <th scope="col" class="py-2 pr-4 text-right">
              Ratio
            </th>
            <th scope="col" class="py-2">
              Result
            </th>
          </tr>
        </thead>
        <tbody>
          {contrast.map(({ fg, bg, min, use, required, ratio, passes }) => (
            <tr class="border-b border-surface-border">
              <td class="py-2 pr-4">
                <span
                  class="inline-block rounded px-2 py-1 font-semibold"
                  style={{ color: hex[fg], background: hex[bg] }}
                >
                  Aa
                </span>
              </td>
              <td class="py-2 pr-4 font-mono">
                {fg} / {bg}
              </td>
              <td class="py-2 pr-4">{use}</td>
              <td class="py-2 pr-4 text-right font-mono">
                {ratio.toFixed(2)}:1
              </td>
              <td class="py-2">
                {passes ? '✓ Pass' : required ? '✗ Fail' : '✗ Avoid'} ({min}:1)
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </Section>

  <Section aria-labelledby="type">
    <h2 id="type" class="text-3xl font-bold">
      Typography
    </h2>
    <p class="mt-2 max-w-prose">
      <strong>Inter</strong> for text and headings,
      <code>Source Code Pro</code> for code, eyebrows, and tags.
    </p>
    <dl class="mt-8 space-y-6">
      {typeScale.map(({ label, class: className }) => (
        <div class="grid gap-1 border-b border-surface-border pb-6 sm:grid-cols-[14rem_1fr] sm:gap-6">
          <dt class="font-mono text-sm text-on-surface-muted">
            {label}
            <br />
            <span class="text-xs">{className}</span>
          </dt>
          <dd class={className}>Software supply chain security</dd>
        </div>
      ))}
    </dl>
  </Section>

  <Section aria-labelledby="components">
    <h2 id="components" class="text-3xl font-bold">
      Sections &amp; components
    </h2>
    <p class="mt-2 max-w-prose">
      Each <code>&lt;Section&gt;</code> alternates dark → green automatically;
      pass <code>variant</code> to force one. Components read the colors of the
      surface they sit on, so the same markup works on both. Press{' '}
      <kbd>Tab</kbd> to see focus rings.
    </p>
    <div class="mt-8 grid gap-6 lg:grid-cols-2">
      {variants.map((variant) => (
        <div
          class:list={[
            SURFACE_CLASS[variant],
            'rounded-xl border border-surface-border p-6',
          ]}
        >
          <p class="font-mono text-sm text-on-surface-muted">
            surface-{variant}
          </p>
          <p class="mt-4">
            Body text with an <a href="#components">inline link</a>.
          </p>
          <p class="mt-1 text-on-surface-muted">Muted supporting text.</p>
          <div class="mt-4 flex flex-wrap gap-3">
            <Button href="#components">Solid link</Button>
            <Button href="#components" appearance="outline">
              Outline link
            </Button>
            <Button type="button">Button</Button>
          </div>
          <div class="mt-4 flex flex-wrap gap-2">
            <Tag>Static tag</Tag>
            <Tag href="#components">Linked tag</Tag>
          </div>
          <Card class="mt-4">
            <h3 class="text-lg font-semibold">Card</h3>
            <p class="mt-1 text-on-surface-muted">
              Uses the raised shade of its surface.
            </p>
            <code class="mt-3 block text-sm">npm install --ignore-scripts</code>
          </Card>
        </div>
      ))}
    </div>
  </Section>

  <Section aria-labelledby="headers">
    <h2 id="headers" class="text-3xl font-bold">
      Headers
    </h2>
    <p class="mt-2 max-w-prose">
      Inner pages use <code>PageHeader</code>, the one at the top of this page.
      The home page uses <code>HomeHero</code>: the Chain React photo with
      left/right fades over the people beside Chris and a bottom fade into the
      title.
    </p>
    <div class="mt-8 overflow-hidden rounded-xl border border-surface-border">
      <HomeHero headingLevel={2} />
    </div>
  </Section>

  <Section aria-labelledby="prose">
    <h2 id="prose" class="text-3xl font-bold">
      Blog posts
    </h2>
    <p class="mt-2 max-w-prose">
      Post bodies use <code>prose prose-surface</code>, which maps the
      typography plugin onto the current surface. Posts sit on dark sections.
      Code blocks use <code>src/styles/code-theme.ts</code>, built from the
      accent colors, all AA on <code>primary-raised</code>.
    </p>
    <div class="surface-primary mt-8 rounded-xl border border-surface-border p-6 sm:p-10">
      <div class="prose prose-lg prose-surface max-w-none">
        <h3>Section heading inside a post</h3>
        <p>
          Body copy with a <a href="#prose">link</a>, <strong>bold text</strong>
          , and <code>inline code</code>.
        </p>
        <blockquote>A pull quote from the post.</blockquote>
        <ul>
          <li>Unordered list item</li>
          <li>Another item</li>
        </ul>
        <Code code={codeSample} lang="ts" theme={codeTheme} />
      </div>
    </div>
  </Section>

  <Section aria-labelledby="pending">
    <h2 id="pending" class="text-3xl font-bold">
      Coming later
    </h2>
    <ul class="mt-4 list-disc space-y-1 pl-5">
      <li>Form fields: added with the contact form (#8)</li>
    </ul>
  </Section>
</PageLayout>
