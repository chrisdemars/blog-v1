---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import Tag from '../components/Tag.astro';
import Card from '../components/Card.astro';
import { SITE } from '../config';

// Temporary preview of the design system (#2). Replaced by the real home
// page in #3; the full reference moves to /design-system in #15.
const sections = ['Software supply chain', 'Accessibility', 'Frontend & CSS'];
---

<BaseLayout title={SITE.title} description={SITE.description}>
  {sections.map((topic, i) => (
    <Section>
      <p class="font-mono text-sm text-on-surface-muted">Section {i + 1}</p>
      <h1 class="mt-2 text-4xl font-bold sm:text-5xl">{SITE.name}</h1>
      <p class="mt-2 text-xl text-on-surface-muted">{SITE.jobTitle}</p>
      <p class="mt-6 max-w-prose">
        Talking {topic.toLowerCase()} at conferences. Read the{' '}
        <a href="#">latest blog post</a> or see where I'm speaking next.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <Button href="#">Book me to speak</Button>
        <Button href="#" appearance="outline">
          Conference talks
        </Button>
      </div>
      <div class="mt-6 flex flex-wrap gap-2">
        <Tag>SBOMs</Tag>
        <Tag href="#">npm</Tag>
        <Tag>a11y</Tag>
      </div>
      <Card class="mt-8 max-w-md">
        <h2 class="text-lg font-semibold">{topic}</h2>
        <p class="mt-1 text-on-surface-muted">
          Cards use the raised surface of whichever section they sit in.
        </p>
        <code class="mt-3 block text-sm">npm install --ignore-scripts</code>
      </Card>
    </Section>
  ))}
</BaseLayout>
